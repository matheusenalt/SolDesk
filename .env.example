# Uso local. setup gera POSTGRES_PASSWORD se este campo estiver vazio.
POSTGRES_DB=soldesk
POSTGRES_USER=soldesk_migrator
POSTGRES_PASSWORD=
RUNTIME_PASSWORD=
DOWNLOAD_SIGNING_KEY=
SOLDESK_MODE=community
SOLDESK_INSTANCE_NAME=Instância SolDesk
ALLOW_ORG_SIGNUP=false
ENVIRONMENT=development
WEB_PORT=8080
API_PORT=8000
DEV_PORT=5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
# Fora do Docker: exporte DATABASE_URL com credenciais locais ou use SQLite só para testes.
# Não preencha DATABASE_URL aqui: o Compose injeta a URL interna do PostgreSQL.
# Mock offline reutiliza o relato digitado; não reconhece fala nem baixa modelos.
TRANSCRIPTION_PROVIDER=mock
STORAGE_BACKEND=local
UPLOAD_MAX_BYTES=26214400
AUDIO_MAX_SECONDS=600
AUDIO_JOB_TIMEOUT=300
CLAMAV_ENABLED=false
# S3/MinIO opcionais. Somente no servidor; não compartilhar credenciais.
S3_ENDPOINT_URL=http://object-store:9000
S3_BUCKET=soldesk-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
## API continua privada por padrão. Para teste LAN explícito, use o IP local em API_BIND_HOST.
API_BIND_HOST=127.0.0.1
