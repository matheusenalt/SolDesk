# Uso local. setup gera POSTGRES_PASSWORD se este campo estiver vazio.
POSTGRES_DB=soldesk
POSTGRES_USER=soldesk_migrator
POSTGRES_PASSWORD=
SOLDESK_MODE=community
ALLOW_ORG_SIGNUP=false
ENVIRONMENT=development
WEB_PORT=8080
API_PORT=8000
DEV_PORT=5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Fora do Docker: exporte DATABASE_URL com credenciais locais ou use SQLite só para testes.
# Não preencha DATABASE_URL aqui: o Compose injeta a URL interna do PostgreSQL.
